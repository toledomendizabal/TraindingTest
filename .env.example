# ============================================================
# TradingSignal Pro - Variables de entorno
# Copia este archivo como ".env" y completa tus valores reales.
# NUNCA subas el archivo ".env" real a Git (ya está en .gitignore).
# ============================================================

# --- MetaTrader 5: ejecución en vivo (órdenes reales) ---
#
# IMPORTANTE: el paquete MetaTrader5 se conecta a una terminal MT5 LOCAL
# vía IPC (no es una API remota). La terminal MT5 debe estar instalada y
# ABIERTA en la misma máquina donde corre este backend (normalmente
# Windows; en Linux/Mac necesitas Wine o un servidor Windows dedicado).
#
# MT5_LIVE_TRADING_ENABLED es un interruptor de seguridad EXPLÍCITO.
# Por defecto (si no defines esta variable) el sistema NO opera en vivo,
# solo genera señales como hasta ahora. Ponlo en "true" únicamente
# cuando estés listo para enviar órdenes reales al bróker.
#
# Recomendación: prueba primero con las credenciales de una cuenta DEMO
# de tu bróker durante varios días antes de usar una cuenta real.
MT5_LIVE_TRADING_ENABLED=false

# Credenciales de tu cuenta MT5 (demo o real). El número de cuenta
# (login) es el que te da tu bróker, junto con la contraseña y el
# nombre del servidor (ej. "ICMarketsSC-Demo", "Deriv-Server", etc.
# Lo ves en MT5: Herramientas > Opciones > Servidor, o en el correo de
# bienvenida de tu bróker).
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password_de_mt5_aqui
MT5_SERVER=NombreDelServidor-Demo

# Ruta al ejecutable terminal64.exe. Déjalo vacío si solo tienes una
# instalación de MT5 (la detecta automáticamente). Solo complétalo si
# tienes varias terminales instaladas o una instalación portable.
# Ejemplo Windows: C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# Número "mágico" para identificar las órdenes de este sistema entre
# tus demás operaciones en la misma cuenta (útil si también operas
# manualmente). Cualquier número entero sirve, solo debe ser único.
MT5_MAGIC_NUMBER=202607

# Desviación máxima de precio permitida (en puntos del bróker) al
# enviar una orden a mercado, antes de rechazarla por slippage.
MT5_DEVIATION_POINTS=20


# ============================================================
# Variables ya existentes (referencia)
# ============================================================

# Ruta donde el Expert Advisor de MT4/MT5 exporta los archivos de
# precios/historial (PriceExporter.mq4/mq5). Ejemplo:
# C:\Users\TuUsuario\AppData\Roaming\MetaQuotes\Terminal\<ID>\MQL5\Files
MT4_FILES_PATH=
